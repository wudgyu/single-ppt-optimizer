APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://ppt_agent:ppt_agent@postgres:5432/ppt_agent
REDIS_URL=redis://redis:6379/0
STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
ARTIFACT_TTL_DAYS=7

LLM_PROVIDER=openai
LLM_API_KEY=set-in-secret-manager
LLM_BASE_URL=
LLM_CONTENT_MODEL=approved-content-model-id
LLM_VISION_MODEL=approved-multimodal-model-id
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_ALLOW_WEB_RESEARCH=false

PPTX_GENERATOR_COMMAND=node
PPTX_GENERATOR_ENTRY=/app/pptx-generator/dist/index.js
LIBREOFFICE_BIN=/usr/bin/libreoffice
PDFTOPPM_BIN=/usr/bin/pdftoppm
RENDER_DPI=150
RENDER_TIMEOUT_SECONDS=90
MAX_UPLOAD_MB=100
MAX_SOURCE_PPTX_SLIDES=100
MAX_REPAIR_ROUNDS=2
